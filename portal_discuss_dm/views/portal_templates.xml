<odoo>
    <template id="chats_list" name="Portal Discuss: chats list">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True" />
            <div class="container pt16 pb32">
                <h1 class="mb-4">Messages</h1>
                <div class="row">
                    <t t-foreach="chats" t-as="chat">
                        <div class="col-12 pt4 pb4">
                            <a t-attf-href="/discuss/channel/#{chat['channel'].id}" class="text-decoration-none">
                                <div class="card">
                                    <div class="card-body d-flex justify-content-between align-items-center p-3">
                                        <div>
                                            <div class="fs-4 fw-bold text-body" t-out="chat['other'].name or chat['channel'].name" />
                                            <div class="text-muted" t-out="chat['preview']" />
                                        </div>
                                        <span t-if="chat['unread']" class="badge text-bg-danger" t-out="chat['unread']" />
                                    </div>
                                </div>
                            </a>
                        </div>
                    </t>
                    <p t-if="not chats" class="text-muted">Aucune conversation pour l'instant.</p>
                </div>
            </div>
        </t>
    </template>
</odoo>
