<odoo>
    <!-- Core rules (mail.ir_rule_discuss_channel_all and the member
         rules) only grant channels of type "channel" through
         group_public_id — membership is never considered. These rules
         add membership-based access for portal users. Group rules are
         OR-ed, so isolation is preserved: portal users only ever see
         the channels they belong to. -->
    <record id="ir_rule_discuss_channel_portal_member" model="ir.rule">
        <field name="name">discuss.channel: portal members access their channels</field>
        <field name="model_id" ref="mail.model_discuss_channel" />
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
        <field name="domain_force">[("is_member", "=", True)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="ir_rule_discuss_channel_member_portal_read" model="ir.rule">
        <field name="name">discuss.channel.member: portal members read members of their channels</field>
        <field name="model_id" ref="mail.model_discuss_channel_member" />
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
        <field name="domain_force">[("channel_id.is_member", "=", True)]</field>
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <!-- Own member line: mark as read, fold, leave — required by the
         public Discuss page. -->
    <record id="ir_rule_discuss_channel_member_portal_self" model="ir.rule">
        <field name="name">discuss.channel.member: portal members manage their own line</field>
        <field name="model_id" ref="mail.model_discuss_channel_member" />
        <field name="groups" eval="[Command.link(ref('base.group_portal'))]" />
        <field name="domain_force">[("is_self", "=", True), ("channel_id.is_member", "=", True)]</field>
        <field name="perm_read" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="True" />
    </record>
</odoo>
